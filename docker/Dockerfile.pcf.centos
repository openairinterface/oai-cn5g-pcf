#---------------------------------------------------------------------
#
# Dockerfile for the OpenAirInterface PCF service
#   Valid for CentOS Stream 10
#
#---------------------------------------------------------------------

#---------------------------------------------------------------------
# BUILDER IMAGE
#---------------------------------------------------------------------

FROM quay.io/centos/centos:stream10 AS oai-pcf-builder

ENV IS_DOCKERFILE=1

# meson and ninja-build come from CRB; libidn-devel comes from EPEL.
# The other build_pcf dependencies are in BaseOS/AppStream.
RUN dnf config-manager --set-enabled crb && \
    dnf install epel-release -y && \
    dnf update -y && \
    # Log the exact OS release used for the build.
    cat /etc/os-release && \
    dnf install -y \
        psmisc \
        git \
        diffutils \
        libasan \
        wget \
        gcc-plugin-devel \
        file && \
    # Libraries built from source are installed under /usr/local, which is not
    # on the default loader path on EL. This is also needed for the ldd check.
    echo "/usr/local/lib" > /etc/ld.so.conf.d/local-lib.conf && \
    echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local-lib.conf

# Git configuration
RUN git config --global https.postBuffer 123289600 && \
    git config --global http.sslverify false

# Copy source code
WORKDIR /openair-pcf
COPY . /openair-pcf

# Install and Build PCF
WORKDIR /openair-pcf/build/scripts
RUN ./build_pcf --install-deps --force
RUN ldconfig && \
    ./build_pcf --clean --Verbose --build-type Release --jobs && \
    ldd /openair-pcf/build/pcf/build/pcf && \
    mv /openair-pcf/build/pcf/build/pcf /openair-pcf/build/pcf/build/oai_pcf

FROM mikefarah/yq:latest AS yq-source

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM quay.io/centos/centos:stream10-minimal AS oai-pcf
ENV TZ=Europe/Paris

RUN microdnf update -y && \
    microdnf install -y \
# Timezone data, and debugging/networking utilities
      tzdata \
      procps-ng \
      psmisc \
      net-tools \
      iputils \
      tcpdump \
# Runtime dependencies of oai_pcf
      libicu \
      boost \
      libevent \
      nettle \
      findutils && \
    microdnf clean all -y && \
    rm -rf /var/cache/yum /var/cache/dnf

# Copy executable and generated libraries
WORKDIR /openair-pcf/bin
COPY --from=oai-pcf-builder \
    /openair-pcf/build/pcf/build/oai_pcf \
    /openair-pcf/scripts/healthcheck.sh \
    ./
COPY --from=yq-source /usr/bin/yq /usr/bin

# Only the libraries built from source; the rest come from the packages above.
# pistache (meson) and nghttp2 (autotools) install into lib, the CMake-built
# spdlog, fmt, yaml-cpp and cpr into lib64. EL 10 ships no MySQL client, so
# the ODB stack, its MySQL client and the OpenSSL 1.1 it links all come from
# the build2 toolchain under lib.
COPY --from=oai-pcf-builder \
    /usr/local/lib/libpistache.so* \
    /usr/local/lib/libnghttp2_asio.so \
    /usr/local/lib/libnghttp2_asio.so.1 \
    /usr/local/lib64/libspdlog.so \
    /usr/local/lib64/libfmt.so \
    /usr/local/lib64/libyaml-cpp.so.0.* \
    /usr/local/lib64/libcpr.so.1* \
    /usr/local/lib/libodb-2.5.so \
    /usr/local/lib/libodb-mysql-2.5.so \
    /usr/local/lib/libmysqlclient-21.so \
    /usr/local/lib/libssl-1.1.so \
    /usr/local/lib/libcrypto-1.1.so \
    /usr/lib64/

RUN ldconfig && \
    ldd /openair-pcf/bin/oai_pcf && \
    # ldd exits 0 even when a library is missing, so check its output
    ! ldd /openair-pcf/bin/oai_pcf | grep -q 'not found'

# Copy the template configuration file; the configuration folder is flat
WORKDIR /openair-pcf/etc
COPY --from=oai-pcf-builder \
    /openair-pcf/etc/config.yaml \
    ./

WORKDIR /openair-pcf

# Expose ports
EXPOSE 80/tcp 8080/tcp

# Configure healthcheck
HEALTHCHECK --interval=10s \
            --timeout=15s \
            --retries=6 \
    CMD /openair-pcf/bin/healthcheck.sh

CMD ["/openair-pcf/bin/oai_pcf", "-c", "/openair-pcf/etc/config.yaml", "-o"]
